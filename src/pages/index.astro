---
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/zcool-xiaowei';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#131824" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>六爻 · 心有所疑，不妨一问</title>
    <meta name="description" content="写下所问，静心，摇六次铜钱成卦。程序按纳甲法排盘，附卦爻辞原文与白话。" />
  </head>
  <body>
    <div class="screen">
      <header>
        <div class="brand">
          <span class="seal" aria-hidden="true">爻</span>
          <span class="name">六爻</span>
        </div>
        <button class="sound" aria-label="音效：已关闭">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h3l5-4v14l-5-4H4z"></path><path d="M16 9.5l5 5M21 9.5l-5 5"></path></svg>
        </button>
      </header>
      <main>
        <h1 class="motto">
          <span>心有所疑</span>
          <span>不妨一问</span>
        </h1>
        <svg class="line" viewBox="0 0 240 24" aria-hidden="true"><path d="M5 12.5C3 7.5 8 4.5 17 5L122 6.5L229 8.5C236 8.8 239 11.5 236.5 14.5C233 17.8 225 16.8 215 16.8L120 17.6L19 19.5C9 20.2 6.5 16.5 5 12.5Z"></path></svg>
        <div class="cta">
          <a class="cast" href="#">起卦</a>
          <span class="hint">一事一问 · 六次摇卦</span>
        </div>
      </main>
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: var(--night);
    color: var(--on-night);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
</style>

<style>
  .screen {
    min-height: 100dvh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: max(16px, env(safe-area-inset-top)) var(--gutter) max(36px, env(safe-area-inset-bottom));
    background: radial-gradient(ellipse 80% 55% at 50% 44%, var(--night-2) 0%, var(--night) 70%);
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--tap);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .seal {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    background: var(--seal);
    color: var(--on-night);
    font-family: var(--font-display);
    font-size: 17px;
    border-radius: var(--radius);
  }
  .name {
    font-size: var(--fs-s);
    letter-spacing: 0.4em;
    color: rgb(248 244 237 / 0.78);
  }
  .sound {
    width: var(--tap);
    height: var(--tap);
    display: grid;
    place-items: center;
    padding: 0;
    background: none;
    border: none;
    color: rgb(248 244 237 / 0.6);
    cursor: pointer;
  }
  main {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 52px;
  }
  .motto {
    margin: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-2xl);
    letter-spacing: 0.38em;
    line-height: 1;
  }
  .motto span {
    display: block;
  }
  .motto span + span {
    margin-right: 30px;
    padding-top: 1.2em;
    color: rgb(248 244 237 / 0.86);
  }
  .line {
    width: 188px;
    height: 19px;
    fill: var(--gold);
    animation: breathe var(--t-breath) ease-in-out infinite;
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .cast {
    width: 208px;
    height: var(--btn-h);
    box-sizing: border-box;
    display: grid;
    place-items: center;
    padding-left: 0.9em;
    border: 1px solid var(--gold);
    background: rgb(192 147 81 / 0.07);
    color: var(--gold-hi);
    font-size: 18px;
    letter-spacing: 0.9em;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .hint {
    font-size: var(--fs-xs);
    letter-spacing: 0.3em;
    color: rgb(248 244 237 / 0.62);
  }
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      animation: none;
    }
  }
</style>
