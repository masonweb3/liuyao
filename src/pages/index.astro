---
import homeBody from '../fonts/home-body.woff2?url';
import homeDisplay from '../fonts/home-display.woff2?url';
import webfonts from '../styles/webfonts.css?url';
import '../styles/fonts.css';
import '../styles/tokens.css';
import Ask from '../components/Ask.astro';
import Calm from '../components/Calm.astro';
import Cast from '../components/Cast.astro';
import History from '../components/History.astro';
import Home from '../components/Home.astro';
import Manual from '../components/Manual.astro';
import Notice from '../components/Notice.astro';
import Reading from '../components/Reading.astro';
import Reveal from '../components/Reveal.astro';
import Topic from '../components/Topic.astro';
import { EMERGENCY, INSINCERE } from '../data/copy';

const title = '六爻 · 在线摇卦起卦、纳甲排盘与白话解读';
const description = '心有所疑，不妨一问。写下所问，摇六次铜钱成卦，按纳甲法排盘断吉凶，附卦爻辞原文与白话解读。免费，无广告，不用登录。';
// 绝对地址要有正式域名（astro.config.mjs 的 site）；没填时这些标签不输出。
const url = (path: string) => Astro.site && new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#131824" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- 其余的字：不阻塞首次渲染。须排在打包样式之前，首屏子集（fonts.css）才优先。 -->
    <link rel="stylesheet" href={webfonts} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={webfonts} /></noscript>
    <!-- 首屏的字，见 tools/subset-fonts.py -->
    <link rel="preload" href={homeDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={homeBody} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="六爻" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content="六爻 · 心有所疑，不妨一问" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.site && (
      <>
        <link rel="canonical" href={url('/')} />
        <meta property="og:url" content={url('/')} />
        <meta property="og:image" content={url('/og.png')} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="六爻：心有所疑，不妨一问" />
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: '六爻', url: url('/'), inLanguage: 'zh-CN', description })}
        />
      </>
    )}
  </head>
  <body>
    <!-- 爻的墨边：笔触边缘轻微起毛 -->
    <svg class="defs" aria-hidden="true">
      <filter id="ink">
        <feTurbulence type="fractalNoise" baseFrequency="0.5" numOctaves="2" seed="3" result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4"></feDisplacementMap>
      </filter>
    </svg>

    <!-- 一屏一件事：同一时刻只有一屏可见，它就是本页的主体。 -->
    <main>
      <Home />
      <Manual />
      <Ask />

      <Notice screen="guard" guard title="先停一停" body={['从你写下的话里，我们感到你可能正经历很难熬的时刻。', '这件事不适合交给卦象。此刻，更值得有一个真实的人听你说。']}>
        <a class="help" href="https://findahelpline.com" target="_blank" rel="noopener">
          查找你所在地区的求助热线
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg>
        </a>
        <a class="tel" href="tel:12356"><span>拨打 12356 心理援助热线</span><span class="where">中国大陆</span></a>
        <button class="quiet" data-go="home" data-clear>我想先静一静</button>
        <p class="note">如果你正身处危险之中，请立即拨打当地紧急电话。</p>
      </Notice>

      <Notice screen="decline" title="此问不占" body={['彩票号码、赌局输赢，是概率之事，卦象给不出答案。', '卦为心中之疑而设。换一件真正让你犹豫的事，再来问。']}>
        <Fragment slot="extra">
          <svg class="stroke" viewBox="0 0 240 24" aria-hidden="true"><path d="M5 12.5C3 7.5 8 4.5 17 5L122 6.5L229 8.5C236 8.8 239 11.5 236.5 14.5C233 17.8 225 16.8 215 16.8L120 17.6L19 19.5C9 20.2 6.5 16.5 5 12.5Z"></path></svg>
          <p class="quote">善为《易》者不占。<span>——《荀子·大略》</span></p>
        </Fragment>
        <button class="btn" style="--ls: 0.5em" data-go="ask" data-clear>换一件事问</button>
      </Notice>

      <Notice screen="emergency" title={EMERGENCY.title} body={EMERGENCY.body}>
        <button class="btn" style="--ls: 0.5em" data-go="home" data-clear>{EMERGENCY.back}</button>
        <button class="quiet" data-proceed>{EMERGENCY.proceed}</button>
        <p class="note">{EMERGENCY.note}</p>
      </Notice>

      <Notice screen="insincere" title={INSINCERE.title} body={[INSINCERE.body]}>
        <button class="btn" style="--ls: 0.5em" data-go="ask">{INSINCERE.action}</button>
      </Notice>

      <Topic />
      <Calm />
      <Cast />
      <Reveal />
      <Reading />
      <History />
    </main>

    <script>
      import '../scripts/ritual.ts';
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: var(--night);
    color: var(--on-night);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  button,
  textarea {
    font: inherit;
    color: inherit;
  }
  :focus-visible {
    outline: 1px solid var(--gold-hi);
    outline-offset: 3px;
  }
  [hidden] {
    display: none !important;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* 一屏只做一件事：ritual.ts 每次只显示一个 .screen。 */
  .screen {
    position: relative;
    min-height: 100dvh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: max(16px, env(safe-area-inset-top)) max(var(--gutter), env(safe-area-inset-right))
      max(36px, env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left));
    animation: screen-in var(--t-fade) var(--ease-out);
  }
  .screen:focus {
    outline: none;
  }
  @keyframes screen-in {
    from {
      opacity: 0;
    }
  }
  /* 768–1023：沿用手机版式，内容居中，最宽 640px */
  @media (min-width: 768px) and (max-width: 1023px) {
    .screen {
      padding-inline: max(var(--gutter), calc(50% - 320px));
    }
  }
  @media (min-width: 1024px) {
    .screen {
      padding: 32px 64px 48px;
    }
  }

  /* 主按钮：内容比屏幕高时贴住底部，始终在拇指够得到的地方。 */
  .dock {
    position: sticky;
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 1;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand .seal {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    background: var(--seal);
    color: var(--on-night);
    font-family: var(--font-display);
    font-size: 17px;
    border-radius: var(--radius);
  }
  .brand .name {
    font-size: var(--fs-s);
    letter-spacing: 0.4em;
    color: rgb(248 244 237 / 0.78);
  }

  .btn {
    --ls: 0.9em;
    height: var(--btn-h);
    box-sizing: border-box;
    display: grid;
    place-items: center;
    padding: 0 0 0 var(--ls);
    border: 1px solid var(--gold);
    border-radius: var(--radius);
    background: rgb(192 147 81 / 0.07);
    color: var(--gold-hi);
    font-size: 18px;
    letter-spacing: var(--ls);
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color var(--t-hover),
      background-color var(--t-hover);
  }
  .btn:hover {
    border-color: var(--gold-hi);
  }
  .btn.solid {
    background: var(--gold);
    color: var(--night);
    font-weight: 600;
  }
  .btn.solid:hover {
    background: var(--gold-hi);
  }
  .btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .btn.solid:disabled:hover {
    border-color: var(--gold);
    background: var(--gold);
  }

  @media (min-width: 1024px) {
    .brand {
      gap: 12px;
    }
    .brand .seal {
      width: 30px;
      height: 30px;
      font-size: 19px;
    }
    .brand .name {
      font-size: 15px;
      color: rgb(248 244 237 / 0.8);
    }
    .btn {
      height: 56px;
      font-size: 19px;
    }
  }
</style>

<style>
  /* 拦截、婉拒页的按钮与附注 */
  .help,
  .tel {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .help {
    height: 56px;
    background: var(--on-night);
    color: var(--night);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .tel {
    height: var(--btn-h);
    border: 1px solid rgb(248 244 237 / 0.5);
    color: var(--on-night);
    font-size: 15px;
    letter-spacing: 0.08em;
  }
  .where {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--on-night-2);
  }
  .quiet {
    min-height: var(--tap);
    padding: 0;
    background: none;
    border: none;
    font-size: var(--fs-s);
    letter-spacing: 0.24em;
    color: var(--on-night-2);
    cursor: pointer;
    transition: color var(--t-hover);
  }
  .quiet:hover {
    color: var(--on-night);
  }
  .note {
    margin: 8px 0 0;
    font-size: var(--fs-xs);
    line-height: 1.8;
    text-align: center;
    color: rgb(248 244 237 / 0.62);
  }
  .stroke {
    width: 120px;
    height: 12px;
    margin-top: 16px;
    fill: var(--gold);
  }
  .quote {
    margin: 0;
    font-size: var(--fs-s);
    letter-spacing: 0.16em;
    color: var(--gold);
  }
  .quote span {
    color: rgb(248 244 237 / 0.6);
  }
</style>
