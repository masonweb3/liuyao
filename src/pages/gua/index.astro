---
// 六十四卦目录：通行本卦序，上经三十卦、下经三十四卦。
import Invite from '../../components/Invite.astro';
import Paper from '../../layouts/Paper.astro';
import { GUA, guaPath } from '../../data/gua-slugs';
import guaci from '../../data/guaci.json';
import { markOf, parseGua, shortName } from '../../lib/gua';

const TEXT: Record<string, string> = guaci;
const items = GUA.map(([name]) => ({
  name,
  short: shortName(name),
  // 第十一卦 → 第十一
  no: parseGua(TEXT[name]!).no.slice(0, -1),
  // 上爻在上。格子不另设 aria-label：读屏直接读看得见的字「泰 第十一」，两边一致。
  lines: [...markOf(name)].reverse().map((b) => b === '1'),
}));
const parts = [
  { id: 'shang', title: '上经 · 乾至离', items: items.slice(0, 30) },
  { id: 'xia', title: '下经 · 咸至未济', items: items.slice(30) },
];

const title = '六十四卦目录：卦象、卦辞爻辞原文与白话 · 六爻';
const description =
  '《周易》六十四卦，按通行本卦序排列：上经乾至离三十卦，下经咸至未济三十四卦。每一卦都有卦辞、爻辞、彖传、象传原文，以及本站原创的白话。';
---

<Paper title={title} description={description} path="/gua/" index subset="index">
  <main class="list">
    <section class="intro">
      <h1>六十四卦</h1>
      <p>按《周易》通行本卦序排列。每一卦都有卦辞、爻辞、彖传、象传原文，以及本站原创的白话。</p>
    </section>
    {parts.map((part) => (
      <section class="part" aria-labelledby={part.id}>
        <h2 id={part.id}>{part.title}</h2>
        <div class="grid">
          {part.items.map((g) => (
            <a href={guaPath(g.name)}>
              <span class="lines" aria-hidden="true">
                {g.lines.map((yang) => <span class:list={['yao', { yang }]} />)}
              </span>
              <span class="short">{g.short}</span>
              <span class="no">{g.no}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
    <Invite />
  </main>
</Paper>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  h1,
  h2,
  p {
    margin: 0;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.3;
    letter-spacing: 0.24em;
  }
  .intro p {
    max-width: 640px;
    font-size: 15px;
    line-height: 1.9;
  }
  .part {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.3em;
  }
  h2::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--seal);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .grid a {
    min-height: 92px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--t-hover);
  }
  .grid a:hover {
    border-color: var(--ink);
  }
  /* 细线卦象：小尺寸下比毛笔笔触清楚 */
  .lines {
    width: 28px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .yao {
    height: 3px;
    background: linear-gradient(to right, var(--ink) 11.5px, transparent 11.5px 16.5px, var(--ink) 16.5px);
  }
  .yao.yang {
    background: var(--ink);
  }
  /* 目录里的卦名一律用宋体 */
  .short {
    font-size: 15px;
    line-height: 1.5;
    letter-spacing: 0.08em;
  }
  /* 设计稿 11px；目录里这种小字有 64 个，Lighthouse 判「字太小」（要六成以上的字 ≥12px），改 12px。 */
  .no {
    font-size: var(--fs-xs);
    line-height: 1.5;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }

  @media (min-width: 1024px) {
    .intro,
    .part {
      width: min(1120px, 100%);
      margin-inline: auto;
    }
    h1 {
      font-size: 44px;
    }
    .intro p {
      font-size: var(--fs-m);
    }
    .grid {
      grid-template-columns: repeat(10, minmax(0, 1fr));
    }
    .grid a {
      min-height: 112px;
    }
    .short {
      font-size: 17px;
    }
  }
</style>
