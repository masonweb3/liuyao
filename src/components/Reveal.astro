---
import Bar from "./Bar.astro";
---

<section class="screen reveal" data-screen="reveal" tabindex="-1" hidden>
  <Bar />
  <div class="center">
    <h1 class="sr-only">成卦</h1>
    <div class="pair">
      <figure class="ben">
        <div class="lines" data-ben-lines></div>
        <figcaption>
          <span class="name" tabindex="-1" data-ben-name data-autofocus></span>
          <span class="tag">本卦</span>
        </figcaption>
      </figure>
      <span class="zhi" aria-hidden="true" data-bian>之</span>
      <figure class="bian" data-bian>
        <div class="lines" data-bian-lines></div>
        <figcaption>
          <span class="name" data-bian-name></span>
          <span class="tag">变卦</span>
        </figcaption>
      </figure>
    </div>
    <div class="end">
      <p class="gz" data-ganzhi></p>
      <button class="btn read" data-read>展卷而读</button>
    </div>
  </div>
</section>

<style>
  .reveal {
    background: radial-gradient(ellipse 85% 50% at 50% 42%, var(--night-2) 0%, var(--night) 72%);
  }
  .center {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 44px;
  }
  .pair {
    margin-top: auto;
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }
  .end {
    display: contents;
  }
  figure {
    --w: 132px;
    --h: 13px;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .bian {
    --w: 100px;
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .lines :global(.yao) {
    position: relative;
    width: var(--w);
    height: var(--h);
  }
  .lines :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--gold);
  }
  .lines :global(.moving svg) {
    fill: var(--gold-hi);
    filter: drop-shadow(0 0 5px rgb(226 193 124 / 0.55));
  }
  .lines :global(.mark) {
    position: absolute;
    top: -4px;
    left: -20px;
    font-size: 13px;
    color: var(--gold-hi);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .name {
    padding-left: 0.2em;
    font-family: var(--font-display);
    font-size: 32px;
    letter-spacing: 0.2em;
    outline: none;
  }
  .bian .name {
    font-size: 22px;
  }
  .tag {
    padding-left: 0.4em;
    font-size: var(--fs-xs);
    letter-spacing: 0.4em;
    color: var(--gold);
  }
  .zhi {
    padding-top: 40px;
    font-family: var(--font-display);
    font-size: 18px;
    color: rgb(248 244 237 / 0.55);
  }
  .gz {
    margin: 0;
    font-size: var(--fs-xs);
    letter-spacing: 0.22em;
    text-align: center;
    color: rgb(248 244 237 / 0.6);
  }
  .gz :global(.hour) {
    display: none;
  }
  .read {
    --ls: 0.7em;
    width: 100%;
    margin-top: auto;
  }

  /* 成卦：卦名墨晕浮现，动爻微亮；稍后变卦自右淡入；最后是干支与按钮。 */
  .ben .name,
  .ben .tag {
    animation: reveal-ink var(--t-ink) ease-out both;
  }
  .lines :global(.moving) {
    animation: reveal-glow var(--t-ink) ease-out both;
  }
  .zhi,
  .bian {
    animation: reveal-in var(--t-ink) var(--ease-out) var(--t-bian) both;
  }
  .bian > * {
    opacity: 0.72;
  }
  .gz,
  .read {
    animation: reveal-fade 600ms ease-out calc(var(--t-bian) + var(--t-ink) / 2) both;
  }
  /* 设计稿指定：卦名用小面积模糊做墨晕，只作用于一行字。 */
  @keyframes reveal-ink {
    from {
      opacity: 0;
      filter: blur(4px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }
  @keyframes reveal-glow {
    from {
      opacity: 0.55;
    }
  }
  @keyframes reveal-in {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
  }
  @keyframes reveal-fade {
    from {
      opacity: 0;
    }
  }

  @media (min-width: 1024px) {
    .reveal {
      background: radial-gradient(ellipse 60% 55% at 50% 46%, var(--night-2) 0%, var(--night) 72%);
    }
    .center {
      gap: 64px;
    }
    .pair {
      margin-top: 0;
      gap: 64px;
    }
    .end {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }
    figure {
      --w: 260px;
      --h: 24px;
      gap: 36px;
    }
    .bian {
      --w: 200px;
      --h: 18px;
      padding-top: 22px;
    }
    .ben .lines {
      gap: 22px;
    }
    .bian .lines {
      gap: 18px;
    }
    .lines :global(.moving svg) {
      filter: drop-shadow(0 0 8px rgb(226 193 124 / 0.5));
    }
    .lines :global(.mark) {
      top: 1px;
      left: -30px;
      font-size: var(--fs-m);
    }
    figcaption {
      gap: 8px;
    }
    .name {
      padding-left: 0.24em;
      font-size: 48px;
      letter-spacing: 0.24em;
    }
    .bian .name {
      font-size: 32px;
    }
    .tag {
      font-size: 13px;
    }
    .zhi {
      padding-top: 72px;
      font-size: 26px;
    }
    .gz {
      font-size: 13px;
      letter-spacing: 0.24em;
    }
    .gz :global(.hour) {
      display: inline;
    }
    .read {
      width: 240px;
      margin-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    @keyframes reveal-ink {
      from {
        opacity: 0;
      }
    }
    @keyframes reveal-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
