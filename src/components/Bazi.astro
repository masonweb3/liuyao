    margin-bottom: 8px;
    font-size: var(--fs-xs);
    line-height: 1.5;
    letter-spacing: 0.2em;
    color: var(--ink-2);
  }
  .bazi .chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .bazi .chip {
    position: relative;
    min-height: var(--tap);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--fs-m);
    letter-spacing: 0.3em;
    padding-left: 0.3em;
    cursor: pointer;
    transition: border-color var(--t-hover);
  }
  .bazi .chip:hover {
    border-color: var(--ink-2);
  }
  .bazi .chip:has(:checked) {
    border-color: var(--ink);
  }
  .bazi .chip:has(:checked)::after,
  .bazi .strip button[aria-pressed='true']::after,
  .bazi .ln li[aria-current]::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: 12px;
    height: 2px;
    margin-left: -6px;
    background: var(--seal);
  }
  .bazi .chip:has(:focus-visible),
  .bazi .check:has(:focus-visible),
  .bazi .row:has(:focus-visible) {
    outline: 1px solid var(--ink);
