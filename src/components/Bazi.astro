    font-size: var(--fs-xs);
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  /* 手机：一栏，次序是表单 → 盘面 → 存过的盘 → 盘面上的词（设计稿 27 便签） */
  .bazi .body {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .bazi .left,
  .bazi .right {
    display: contents;
  }
