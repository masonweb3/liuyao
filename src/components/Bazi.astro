    display: none;
  }

  .bazi .tool,
  .bazi .saved,
  .bazi .terms {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .bazi .saved,
  .bazi .terms {
    gap: 12px;
  }

  /* ---------- 表单 ---------- */
  .bazi .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .bazi fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .bazi legend,
  .bazi .label {
    display: block;
