---
// 二十四节气目录（M17-5）：四季各一组，每个节气写这一次的交节日期与一句导语，链到节气页。简体 /jieqi/ 与繁体共用。
import huangliHant from '../data/huangli-hant.json';
import huangliData from '../data/huangli.json';
import Paper from '../layouts/Paper.astro';
import { type Data, termIn, termNeighbors } from '../lib/huangli';
import { beijingYmd, JIEQI, jieqiPath, YEARS, ymd } from '../lib/huangli-days';
import Invite from './Invite.astro';

interface Props {
  hant?: boolean;
}

const { hant = false } = Astro.props;
const t = (hans: string, tw: string) => (hant ? tw : hans);
const data = (hant ? huangliHant : huangliData) as unknown as Data;
const tw = (s: string) => data.names?.[s] ?? s;
const md = (x: string) => `${Number(x.slice(5, 7))}月${Number(x.slice(8))}日`;
// 同节气页：取构建那天还没过完的那一次
const today = ymd(...beijingYmd());
const rows = JIEQI.map(([name]) => {
  const times = YEARS.map((y) => ({ year: y, ...termIn(y, name) }));
  const cur = times.find((x) => termNeighbors(x.date).next.date > today) ?? times[times.length - 1]!;
  return { name, shown: tw(name), when: `${cur.year}年${md(cur.date)} ${cur.time}`, lead: data.jieqi[name]!.lead };
});
const seasons = ['春', '夏', '秋', '冬'].map((s, i) => ({ s, rows: rows.slice(i * 6, i * 6 + 6) }));
const title = t('二十四节气：交节时刻、三候与时令 · 六爻', '二十四節氣：交節時刻、三候與時令 · 六爻');
const description = t(
  '从立春到大寒，二十四节气每一个的交节时刻（北京时间）、太阳黄经、三候与时令。',
  '從立春到大寒，二十四節氣每一個的交節時刻（臺灣時間，UTC+8）、太陽黃經、三候與時令。',
);
---

<Paper title={title} description={description} path="/jieqi/" at="/huangli/" group="huangli" subset="jieqi" hant={hant} ogType="website">
  <main class="list">
    <section class="intro">
      <h1>{t('二十四节气', '二十四節氣')}</h1>
      <p>{t('一年从立春起，每月一节一气。交节时刻按北京时间推算，时令按北半球写。', '一年從立春起，每月一節一氣。交節時刻按臺灣時間（UTC+8）推算，時令按北半球寫。')}</p>
    </section>
    {seasons.map(({ s, rows }) => (
      <section class="season" aria-labelledby={`s-${s}`}>
        <h2 class="head" id={`s-${s}`}>{s}</h2>
        <ul role="list">
          {rows.map((r) => (
            <li>
              <a href={jieqiPath(r.name, hant)}>
                <span class="col">
                  <span class="top"><span class="n">{r.shown}</span><span class="w">{r.when}</span></span>
                  <span class="l">{r.lead}</span>
                </span>
                <span class="arrow" aria-hidden="true">›</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
  <Invite hant={hant} />
  <Fragment slot="foot">
    <p>{t('交节时刻由', '交節時刻由')} <a href="https://github.com/6tail/tyme4ts" rel="noopener">tyme4ts</a> {t('推算（MIT）；导语为本站原创', '推算（MIT）；導語為本站原創')}<span class="stop">。</span></p>
    <p>{t('仅供传统文化参考与娱乐', '僅供傳統文化參考與娛樂')}<span class="stop">。</span></p>
  </Fragment>
</Paper>

<style>
  p,
  h1,
  h2 {
    margin: 0;
  }
  a {
    color: var(--ink);
    text-decoration: none;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.3;
    letter-spacing: 0.24em;
  }
  .intro p {
    font-size: 15px;
    line-height: 1.9;
  }
  .season {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.3em;
  }
  .head::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--seal);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  li a {
    min-height: 52px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .col {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  .n {
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: 0.12em;
  }
  .w {
    font-size: 13px;
    color: var(--ink-2);
  }
  .l {
    font-size: var(--fs-s);
    line-height: 1.8;
    color: var(--ink-2);
  }
  .arrow {
    color: var(--ink-2);
  }
  li a:hover .n {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .list {
      width: min(1120px, 100%);
      margin-inline: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 64px;
    }
    .intro {
      grid-column: 1 / -1;
    }
    h1 {
      font-size: 44px;
    }
    .intro p {
      font-size: var(--fs-m);
    }
    .head {
      font-size: var(--fs-m);
    }
  }
</style>
