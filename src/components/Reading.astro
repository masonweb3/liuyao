---
import { DISCLAIMER, ERRORS, REMIND, REVIEW } from "../data/copy";
import { DAYS, NOTE_MAX, OUTCOMES } from "../lib/revisit";
import Slots from "./Slots.astro";

// 内容由 src/scripts/view.ts 按 src/lib/reading.ts 的结果填入；回访卡、到时提醒见 src/lib/revisit.ts。
const history = Astro.site ? new URL("/?history", Astro.site).href : "/?history";
const facts = [
  ["四柱", "pillars"],
  ["月建", "yue"],
  ["日辰", "ri"],
  ["旬空", "kong"],
  ["本卦", "ben"],
  ["变卦", "bian"],
];
---

<section class="screen reading" data-screen="reading" tabindex="-1" hidden>
  <header class="top">
    <a class="back" href="/" aria-label="回到首屏" data-back>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </a>
    <a class="brand" href="/" aria-label="六爻，回到首屏">
      <span class="seal" aria-hidden="true">爻</span>
      <span class="name" aria-hidden="true">六爻</span>
    </a>
    <nav class="acts">
      <button class="to-history" data-go="history">往卦</button>
      <button class="share-btn" data-share>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1"></rect><path d="M9 8h6M9 12h6"></path></svg>
        分享卡
      </button>
    </nav>
  </header>

  <!-- 回访卡：从往卦点开、到了日子的卦（设计稿 17、D14）。卡上没有起卦、重摇、再问的入口（一事一占）。 -->
  <section
    class="visit"
    aria-labelledby="visit-ask"
    hidden
    data-visit
    data-outcomes={JSON.stringify(REVIEW.outcomes)}
    data-pick={REVIEW.pick}
    data-saved={REVIEW.saved}
    data-unsaved={ERRORS.storage}
  >
    <form class="visit-form" data-visit-form>
      <fieldset>
        <legend id="visit-ask" tabindex="-1">
          <span class="kick">{REVIEW.kicker}</span>
          <span class="recall"><Slots text={REVIEW.ask} /></span>
        </legend>
        <p class="alert" role="alert" data-visit-alert></p>
        <div class="opts">
          {OUTCOMES.map((k) => (
            <Fragment>
              {k === "pending" && <span class="split" aria-hidden="true" />}
              <label class="chip"><input class="sr-only" type="radio" name="outcome" value={k} />{REVIEW.outcomes[k]}</label>
            </Fragment>
          ))}
        </div>
      </fieldset>
      <label class="note">
        <span>{REVIEW.note}</span>
        <input type="text" name="note" maxlength={NOTE_MAX} autocomplete="off" />
      </label>
      <span class="local">{REVIEW.local}</span>
      <button class="keep" type="submit">{REVIEW.save}</button>
    </form>
    <div class="visit-done" hidden data-visit-done>
      <h2 id="visit-told" tabindex="-1">
        <span class="kick"><Slots text={REVIEW.doneKicker} /></span>
        <span class="recall"><Slots text={REVIEW.doneAsk} /></span>
      </h2>
      <div class="told">
        <p><Slots text={REVIEW.told} /></p>
        <p class="told-note" data-visit-note>「<span data-slot="note"></span>」</p>
      </div>
      <button type="button" class="edit" aria-label={REVIEW.editLabel} data-visit-edit>{REVIEW.edit}</button>
      <p class="local">{REVIEW.local}</p>
    </div>
    <div class="visit-skip" hidden data-visit-skip>
      <h2 id="visit-skip" tabindex="-1">{REVIEW.skipped}</h2>
      <span aria-hidden="true">·</span>
      <button type="button" class="edit-link" aria-label={REVIEW.editLabel} data-visit-edit>{REVIEW.edit}</button>
    </div>
    <p class="bless" data-visit-bless>{REVIEW.bless}</p>
    <p class="sr-only" role="status" data-visit-status></p>
  </section>

  <div class="layout">
    <div class="lead">
      <section class="asked">
        <span class="label">所问</span>
        <p data-question></p>
      </section>
      <section class="gua" aria-label="卦象">
        <div class="lines" data-lines></div>
        <div class="names">
          <h1 tabindex="-1" data-autofocus><a class="to-gua" data-name></a></h1>
          <span class="zhi" data-zhi>之<a class="to-gua" data-zhi-name></a></span>
        </div>
      </section>
      <p class="gz" data-gz></p>
      <section class="verdict" aria-label="结论">
        <span class="duan" role="img" data-duan></span>
        <div class="said">
          <p class="conclusion" data-conclusion></p>
          <p class="basis" data-basis></p>
          <p class="basis" data-note></p>
        </div>
      </section>
    </div>

    <div class="main">
      <section class="block">
        <h2 class="head">依据</h2>
        <ol class="list" data-reasons></ol>
      </section>
      <section class="block">
        <h2 class="head">建议</h2>
        <ul class="list advice" data-advice></ul>
      </section>
      <!-- 到时提醒我：收在答的末尾（设计稿 16、D13）。不收邮箱、不推送；日历里只有日期和卦名，不写所问。 -->
      <section
        class="remind"
        aria-label={REMIND.label}
        hidden
        data-remind
        data-summary={REMIND.ics.summary}
        data-body={REMIND.ics.body}
        data-url={history}
        data-unsaved={REMIND.unsaved}
      >
        <button type="button" class="remind-head" aria-expanded="false" aria-controls="remind-panel" data-remind-toggle>
          <svg class="cal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="1"></rect><path d="M4 10h16M9 3v4M15 3v4"></path></svg>
          <span class="rt"><span class="t">{REMIND.title}</span><span class="s">{REMIND.lede}</span></span>
          <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
        <div class="remind-panel" id="remind-panel" hidden>
          <fieldset>
            <legend>{REMIND.legend}</legend>
            <div class="days">
              {DAYS.map((d) => (
                <label class="chip">
                  <input class="sr-only" type="radio" name="remind-days" value={d} checked={d === 7} />
                  <span>{REMIND.day.replace("{n}", String(d))}</span>
                  <span class="due" data-due={d}></span>
                </label>
              ))}
            </div>
          </fieldset>
          <!-- 默认 Apple 在前；view.ts 在安卓、Windows 等上把 Google 挪到前面。紧跟标签的那个是主按钮。 -->
          <div class="get" role="group" aria-labelledby="remind-add">
            <span class="add" id="remind-add">{REMIND.add}</span>
            <button type="button" data-remind-get="apple">{REMIND.apple}</button>
            <button type="button" data-remind-get="google">{REMIND.google}</button>
          </div>
          <p class="got" role="status" data-remind-status></p>
          <p class="fine">{REMIND.fine}</p>
          {(["apple", "google"] as const).map((k) => (
            <template data-remind-done={k}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
              <span><Slots text={REMIND.done[k]} /></span>
            </template>
          ))}
        </div>
      </section>
      <div class="texts">
        {["ben", "bian"].map((k) => (
          <section class="block text" data-text={k}>
            <h2 class="kicker" data-kicker></h2>
            <p class="ci" data-ci></p>
            <p class="bh" data-bh></p>
          </section>
        ))}
      </div>
      <section class="block text">
        <h2 class="kicker" data-dong-heading></h2>
        <div class="yaoci" data-dong-lines></div>
        <p class="bh" data-dong-note></p>
      </section>

      <details class="panel" data-panel>
        <summary>
          <h2>完整盘面</h2>
          <span class="toggle" aria-hidden="true"></span>
        </summary>
        <dl class="facts">
          {facts.map(([dt, key]) => (
            <div data-fact={key}>
              <dt>{dt}</dt>
              <dd data-p={key}></dd>
            </div>
          ))}
        </dl>
        <table>
          <thead>
            <tr>
              <th class="pos">爻位</th>
              <th>六神</th>
              <th>本卦</th>
              <th>爻象</th>
              <th>世应</th>
              <th>变卦</th>
            </tr>
          </thead>
          <tbody data-rows></tbody>
        </table>
        <p class="fu">伏神：<span data-p="fu"></span></p>
      </details>
    </div>
  </div>

  <footer class="end">
    <a class="again" href="/?ask" data-again>再问一事</a>
    <p>同一件事，一卦为定</p>
    <p class="warn" data-storage hidden>{ERRORS.storage}</p>
    <p>{DISCLAIMER[0]}<br />{DISCLAIMER[1]}</p>
  </footer>

  <!-- 分享卡：设计稿只有卡面，没有这一层；按简单弹层做。 -->
  <dialog class="share" aria-label="分享卡" data-share-dialog>
    <div class="frame"><img alt="分享卡" data-card /></div>
    <p class="error" role="alert" data-card-error></p>
    <div class="row">
      <label data-with-q-label><input type="checkbox" data-with-q /> 所问上卡</label>
      <span class="hint">长按图片保存</span>
      <a class="save" href="#" download data-save>保存图片</a>
    </div>
    <form method="dialog"><button class="close">关闭</button></form>
  </dialog>
</section>

<style>
  /* 展卷：纸色自中轴向两侧展开，正文随后淡入。只动 transform 与 opacity。 */
  .screen.reading {
    isolation: isolate;
    gap: 40px;
    color: var(--ink);
    animation: none;
  }
  .reading::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    animation: unroll var(--t-unroll) var(--ease-out) both;
  }
  .reading > * {
    animation: reading-in 200ms ease-out var(--t-unroll) both;
  }
  @keyframes unroll {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes reading-in {
    from {
      opacity: 0;
    }
  }
  /* 展开之后页底也换成纸色，iOS 回弹时不露出暗场。 */
  :global(html:has(.reading:not([hidden]))),
  :global(html:has(.reading:not([hidden])) body) {
    background: var(--paper);
    transition: background-color 0s var(--t-unroll);
  }
  .reading :focus-visible {
    outline-color: var(--ink);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--tap);
  }
  .acts {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .to-history {
    display: none;
    min-height: var(--tap);
    padding: 0;
    background: none;
    border: none;
    font-size: var(--fs-s);
    letter-spacing: 0.24em;
    cursor: pointer;
  }
  .share-btn {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--fs-s);
    letter-spacing: 0.2em;
    cursor: pointer;
    transition: border-color var(--t-hover);
  }
  .share-btn:hover {
    border-color: var(--ink);
  }
  .back {
    width: var(--tap);
    height: var(--tap);
    margin-left: -10px;
    display: grid;
    place-items: center;
    color: var(--ink);
  }
  .top .brand {
    display: none;
    text-decoration: none;
  }
  .reading .brand .name {
    color: var(--ink);
  }

  .layout,
  .lead,
  .main {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .asked {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .asked:has(p:empty) {
    display: none;
  }
  .label {
    font-size: var(--fs-xs);
    letter-spacing: 0.3em;
    color: var(--ink-2);
  }
  .asked p {
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .gua {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 4px 0 0;
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lines :global(.yao) {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lines :global(svg) {
    display: block;
    width: 150px;
    height: 15px;
    fill: var(--ink);
  }
  .lines :global(.mark) {
    font-size: var(--fs-s);
    line-height: 1;
    color: var(--vermilion);
  }
  .names {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 14px;
  }
  h1 {
    margin: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 44px;
    letter-spacing: 0.24em;
    line-height: 1;
    outline: none;
  }
  /* 卦名链到卦页：不抢眼，颜色随文字；竖排时常驻的下划线像一条分隔线，只在悬停、聚焦时出现。 */
  .to-gua {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.3em;
  }
  .to-gua:hover,
  .to-gua:focus-visible {
    text-decoration: underline 1px;
  }
  /* 「之X」字小，可点区域撑到 24px 以上，不改变排版。只往左右和下方撑，不压到上面的「之」；
     焦点框贴着这块区域画，不外扩，也就不盖住「之」。 */
  .zhi .to-gua {
    display: inline-block;
    padding: 0 6px 6px;
    margin: 0 -6px -6px;
    outline-offset: 0;
  }
  .zhi {
    padding-top: 50px;
    writing-mode: vertical-rl;
    font-size: var(--fs-m);
    letter-spacing: 0.3em;
    color: var(--ink-2);
  }
  .gz {
    margin: -16px 0 0;
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    color: var(--ink-2);
  }

  .verdict {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 24px 0;
    border-block: 1px solid var(--rule);
  }
  /* 断语印章：吉红底白字，平墨线框，凶墨底白字 */
  .duan {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 36px;
    border-radius: 3px;
  }
  .duan[data-verdict="吉"] {
    background: var(--seal);
    color: var(--paper);
  }
  .duan[data-verdict="平"] {
    border: 1.5px solid var(--ink);
  }
  .duan[data-verdict="凶"] {
    background: var(--ink);
    color: var(--paper);
  }
  .said {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .conclusion {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .basis {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .head {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3em;
  }
  .head::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--seal);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 1.85;
  }
  .list :global(li) {
    display: flex;
    gap: 12px;
  }
  .list :global(.n) {
    flex-shrink: 0;
    color: var(--seal);
  }
  .advice :global(.n) {
    color: var(--ink-2);
  }

  .texts {
    display: contents;
  }
  .text {
    gap: 18px;
  }
  .kicker {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 400;
    letter-spacing: 0.4em;
    color: var(--ink-2);
  }
  .ci {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.6;
    letter-spacing: 0.16em;
  }
  [data-text="bian"] .ci {
    font-size: 22px;
    letter-spacing: 0.12em;
  }
  .bh {
    margin: 0;
    font-size: 15px;
    line-height: 1.95;
  }
  .bh:empty {
    display: none;
  }
  .yaoci {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .yaoci:empty {
    display: none;
  }
  .yaoci :global(.yc) {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .yaoci :global(.t) {
    flex-shrink: 0;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  .yaoci :global(.t.main) {
    color: var(--seal);
  }
  .yaoci :global(p) {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.6;
    letter-spacing: 0.16em;
  }
  /* 爻辞白话：另起一行、顶格，同卦页手机版；宋体，字号行高同本页的卦辞白话（.bh）。
     爻辞占满爻题右边的余宽，不被挤到下一行。一爻一组，组间比组内疏。 */
  .yaoci:has(.ybh) {
    gap: 24px;
  }
  .yaoci :global(.yc:has(.ybh)) {
    flex-wrap: wrap;
    row-gap: 10px;
  }
  .yaoci :global(.yc:has(.ybh) p:not(.ybh)) {
    flex: 1 1 0;
  }
  .yaoci :global(p.ybh) {
    flex-basis: 100%;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.95;
    letter-spacing: normal;
  }

  /* 完整盘面：给专业用户看，手机默认收起，桌面默认展开 */
  .panel {
    padding: 8px 14px 20px;
    background: var(--paper-2);
    border-radius: var(--radius);
  }
  .panel:not([open]) {
    padding-bottom: 8px;
  }
  summary {
    min-height: var(--tap);
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3em;
  }
  .toggle::after {
    content: "展开";
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--ink-2);
  }
  .panel[open] .toggle::after {
    content: "收起";
  }
  .facts {
    margin: 8px 0 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 13px;
    line-height: 1.6;
  }
  dt {
    display: inline;
    margin-right: 0.5em;
    color: var(--ink-2);
  }
  dd {
    display: inline;
    margin: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-s);
  }
  th {
    height: 32px;
    padding: 0 4px;
    font-size: var(--fs-xs);
    font-weight: 400;
    text-align: left;
    white-space: nowrap;
    color: var(--ink-2);
    border-bottom: 1px solid var(--rule);
  }
  /* 只在「六亲 干支」之间的空格处换行 */
  td {
    height: 42px;
    padding: 4px;
    word-break: keep-all;
    border-bottom: 1px solid var(--rule);
  }
  tbody :global(tr:last-child td) {
    border-bottom: none;
  }
  .pos,
  table :global(.pos) {
    display: none;
  }
  table :global(.god) {
    font-size: 13px;
    color: var(--ink-2);
  }
  table :global(.sy) {
    color: var(--ink-2);
  }
  table :global(.sy.shi) {
    color: var(--seal);
  }
  table :global(tr.yong) {
    background: rgb(171 55 47 / 0.07);
  }
  table :global(tr.yong .ben) {
    color: var(--seal);
    font-weight: 600;
  }
  table :global(.tag) {
    font-size: var(--fs-xs);
    font-weight: 400;
  }
  table :global(.hua) {
    display: none;
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  table :global(.yao) {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  table :global(svg) {
    display: block;
    width: 48px;
    height: 8px;
    fill: var(--ink);
  }
  table :global(.mark) {
    font-size: 11px;
