---
import { DISCLAIMER, ERRORS } from "../data/copy";

// 内容由 ritual.ts 按 src/lib/reading.ts 的结果填入。
const facts = [
  ["四柱", "pillars"],
  ["月建", "yue"],
  ["日辰", "ri"],
  ["旬空", "kong"],
  ["本卦", "ben"],
  ["变卦", "bian"],
];
---

<section class="screen reading" data-screen="reading" tabindex="-1" hidden>
  <header class="top">
    <a class="back" href="/" aria-label="回到首屏" data-back>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </a>
    <a class="brand" href="/" aria-label="六爻，回到首屏">
      <span class="seal" aria-hidden="true">爻</span>
      <span class="name" aria-hidden="true">六爻</span>
    </a>
    <nav class="acts">
      <button class="to-history" data-go="history">往卦</button>
      <button class="share-btn" data-share>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1"></rect><path d="M9 8h6M9 12h6"></path></svg>
        分享卡
      </button>
    </nav>
  </header>

  <div class="layout">
    <div class="lead">
      <section class="asked">
        <span class="label">所问</span>
        <p data-question></p>
      </section>
      <section class="gua" aria-label="卦象">
        <div class="lines" data-lines></div>
        <div class="names">
          <h1 tabindex="-1" data-autofocus><a class="to-gua" data-name></a></h1>
          <span class="zhi" data-zhi>之<a class="to-gua" data-zhi-name></a></span>
        </div>
      </section>
      <p class="gz" data-gz></p>
      <section class="verdict" aria-label="结论">
        <span class="duan" role="img" data-duan></span>
        <div class="said">
          <p class="conclusion" data-conclusion></p>
          <p class="basis" data-basis></p>
          <p class="basis" data-note></p>
        </div>
      </section>
    </div>

    <div class="main">
      <section class="block">
        <h2 class="head">依据</h2>
        <ol class="list" data-reasons></ol>
      </section>
      <section class="block">
        <h2 class="head">建议</h2>
        <ul class="list advice" data-advice></ul>
      </section>
      <div class="texts">
        {["ben", "bian"].map((k) => (
          <section class="block text" data-text={k}>
            <h2 class="kicker" data-kicker></h2>
            <p class="ci" data-ci></p>
            <p class="bh" data-bh></p>
          </section>
        ))}
      </div>
      <section class="block text">
        <h2 class="kicker" data-dong-heading></h2>
        <div class="yaoci" data-dong-lines></div>
        <p class="bh" data-dong-note></p>
      </section>

      <details class="panel" data-panel>
        <summary>
          <h2>完整盘面</h2>
          <span class="toggle" aria-hidden="true"></span>
        </summary>
        <dl class="facts">
          {facts.map(([dt, key]) => (
            <div data-fact={key}>
              <dt>{dt}</dt>
              <dd data-p={key}></dd>
            </div>
          ))}
        </dl>
        <table>
          <thead>
            <tr>
              <th class="pos">爻位</th>
              <th>六神</th>
              <th>本卦</th>
              <th>爻象</th>
              <th>世应</th>
              <th>变卦</th>
            </tr>
          </thead>
          <tbody data-rows></tbody>
        </table>
        <p class="fu">伏神：<span data-p="fu"></span></p>
      </details>
    </div>
  </div>

  <footer class="end">
    <a class="again" href="/?ask">再问一事</a>
    <p>同一件事，一卦为定</p>
    <p class="warn" data-storage hidden>{ERRORS.storage}</p>
    <p>{DISCLAIMER[0]}<br />{DISCLAIMER[1]}</p>
  </footer>

  <!-- 分享卡：设计稿只有卡面，没有这一层；按简单弹层做。 -->
  <dialog class="share" aria-label="分享卡" data-share-dialog>
    <div class="frame"><img alt="分享卡" data-card /></div>
    <p class="error" role="alert" data-card-error></p>
    <div class="row">
      <label data-with-q-label><input type="checkbox" data-with-q /> 所问上卡</label>
      <span class="hint">长按图片保存</span>
      <a class="save" href="#" download data-save>保存图片</a>
    </div>
    <form method="dialog"><button class="close">关闭</button></form>
  </dialog>
</section>

<style>
  /* 展卷：纸色自中轴向两侧展开，正文随后淡入。只动 transform 与 opacity。 */
  .screen.reading {
    isolation: isolate;
    gap: 40px;
    color: var(--ink);
    animation: none;
  }
  .reading::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    animation: unroll var(--t-unroll) var(--ease-out) both;
  }
  .reading > * {
    animation: reading-in 200ms ease-out var(--t-unroll) both;
  }
  @keyframes unroll {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes reading-in {
    from {
      opacity: 0;
    }
  }
  /* 展开之后页底也换成纸色，iOS 回弹时不露出暗场。 */
  :global(html:has(.reading:not([hidden]))),
  :global(html:has(.reading:not([hidden])) body) {
    background: var(--paper);
    transition: background-color 0s var(--t-unroll);
  }
  .reading :focus-visible {
    outline-color: var(--ink);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--tap);
  }
  .acts {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .to-history {
    display: none;
    min-height: var(--tap);
    padding: 0;
    background: none;
    border: none;
    font-size: var(--fs-s);
    letter-spacing: 0.24em;
    cursor: pointer;
  }
  .share-btn {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--fs-s);
    letter-spacing: 0.2em;
    cursor: pointer;
    transition: border-color var(--t-hover);
  }
  .share-btn:hover {
    border-color: var(--ink);
  }
  .back {
    width: var(--tap);
    height: var(--tap);
    margin-left: -10px;
    display: grid;
    place-items: center;
    color: var(--ink);
  }
  .top .brand {
    display: none;
    text-decoration: none;
  }
  .reading .brand .name {
    color: var(--ink);
  }

  .layout,
  .lead,
  .main {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .asked {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .asked:has(p:empty) {
    display: none;
  }
  .label {
    font-size: var(--fs-xs);
    letter-spacing: 0.3em;
    color: var(--ink-2);
  }
  .asked p {
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .gua {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 4px 0 0;
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lines :global(.yao) {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lines :global(svg) {
    display: block;
    width: 150px;
    height: 15px;
    fill: var(--ink);
  }
  .lines :global(.mark) {
    font-size: var(--fs-s);
    line-height: 1;
    color: var(--vermilion);
  }
  .names {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 14px;
  }
  h1 {
    margin: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 44px;
    letter-spacing: 0.24em;
    line-height: 1;
    outline: none;
  }
  /* 卦名链到卦页：不抢眼，颜色随文字；竖排时常驻的下划线像一条分隔线，只在悬停、聚焦时出现。 */
  .to-gua {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.3em;
  }
  .to-gua:hover,
  .to-gua:focus-visible {
    text-decoration: underline 1px;
  }
  /* 「之X」字小，可点区域撑到 24px 以上，不改变排版 */
  .zhi .to-gua {
    display: inline-block;
    padding: 6px;
    margin: -6px;
  }
  .zhi {
    padding-top: 50px;
    writing-mode: vertical-rl;
    font-size: var(--fs-m);
    letter-spacing: 0.3em;
    color: var(--ink-2);
  }
  .gz {
    margin: -16px 0 0;
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    color: var(--ink-2);
  }

  .verdict {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 24px 0;
    border-block: 1px solid var(--rule);
  }
  /* 断语印章：吉红底白字，平墨线框，凶墨底白字 */
  .duan {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 36px;
    border-radius: 3px;
  }
  .duan[data-verdict="吉"] {
    background: var(--seal);
    color: var(--paper);
  }
  .duan[data-verdict="平"] {
    border: 1.5px solid var(--ink);
  }
  .duan[data-verdict="凶"] {
    background: var(--ink);
    color: var(--paper);
  }
  .said {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .conclusion {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .basis {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .head {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3em;
  }
  .head::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--seal);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 1.85;
  }
  .list :global(li) {
    display: flex;
    gap: 12px;
  }
  .list :global(.n) {
    flex-shrink: 0;
    color: var(--seal);
  }
  .advice :global(.n) {
    color: var(--ink-2);
  }

  .texts {
    display: contents;
  }
  .text {
    gap: 18px;
  }
  .kicker {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 400;
    letter-spacing: 0.4em;
    color: var(--ink-2);
  }
  .ci {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.6;
    letter-spacing: 0.16em;
  }
  [data-text="bian"] .ci {
    font-size: 22px;
    letter-spacing: 0.12em;
  }
  .bh {
    margin: 0;
    font-size: 15px;
    line-height: 1.95;
  }
  .bh:empty {
    display: none;
  }
  .yaoci {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .yaoci:empty {
    display: none;
  }
  .yaoci :global(.yc) {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .yaoci :global(.t) {
    flex-shrink: 0;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  .yaoci :global(.t.main) {
    color: var(--seal);
  }
  .yaoci :global(p) {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.6;
    letter-spacing: 0.16em;
  }

  /* 完整盘面：给专业用户看，手机默认收起，桌面默认展开 */
  .panel {
    padding: 8px 14px 20px;
    background: var(--paper-2);
    border-radius: var(--radius);
  }
  .panel:not([open]) {
    padding-bottom: 8px;
  }
  summary {
    min-height: var(--tap);
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3em;
  }
  .toggle::after {
    content: "展开";
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--ink-2);
  }
  .panel[open] .toggle::after {
    content: "收起";
  }
  .facts {
    margin: 8px 0 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 13px;
    line-height: 1.6;
  }
  dt {
    display: inline;
    margin-right: 0.5em;
    color: var(--ink-2);
  }
  dd {
    display: inline;
    margin: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-s);
  }
  th {
    height: 32px;
    padding: 0 4px;
    font-size: var(--fs-xs);
    font-weight: 400;
    text-align: left;
    white-space: nowrap;
    color: var(--ink-2);
    border-bottom: 1px solid var(--rule);
  }
  /* 只在「六亲 干支」之间的空格处换行 */
  td {
    height: 42px;
    padding: 4px;
    word-break: keep-all;
    border-bottom: 1px solid var(--rule);
  }
  tbody :global(tr:last-child td) {
    border-bottom: none;
  }
  .pos,
  table :global(.pos) {
    display: none;
  }
  table :global(.god) {
    font-size: 13px;
    color: var(--ink-2);
  }
  table :global(.sy) {
    color: var(--ink-2);
  }
  table :global(.sy.shi) {
    color: var(--seal);
  }
  table :global(tr.yong) {
    background: rgb(171 55 47 / 0.07);
  }
  table :global(tr.yong .ben) {
    color: var(--seal);
    font-weight: 600;
  }
  table :global(.tag) {
    font-size: var(--fs-xs);
    font-weight: 400;
  }
  table :global(.hua) {
    display: none;
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  table :global(.yao) {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  table :global(svg) {
    display: block;
    width: 48px;
    height: 8px;
    fill: var(--ink);
  }
  table :global(.mark) {
    font-size: 11px;
    line-height: 1;
    color: var(--vermilion);
  }
  .fu {
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .end {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-top: 16px;
  }
  .again {
    width: 100%;
    height: var(--btn-h);
    box-sizing: border-box;
    display: grid;
    place-items: center;
    padding-left: 0.6em;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    color: var(--ink);
    font-size: 17px;
    letter-spacing: 0.6em;
    text-decoration: none;
    transition: background-color var(--t-hover);
  }
  .again:hover {
    background: rgb(45 46 54 / 0.05);
  }
  .end p {
    margin: 0;
    font-size: var(--fs-xs);
    line-height: 1.8;
    letter-spacing: 0.12em;
    text-align: center;
    color: var(--ink-2);
  }

  .end .warn {
    color: var(--seal);
  }

  .share {
    width: min(440px, 100% - 32px);
    max-height: calc(100dvh - 32px);
    box-sizing: border-box;
    padding: 16px;
    border: none;
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
  }
  .share[open] {
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: share-in var(--t-fade) var(--ease-out);
  }
  .share::backdrop {
    background: rgb(19 24 36 / 0.6);
  }
  @keyframes share-in {
    from {
      opacity: 0;
    }
  }
  /* 卡片 3:4，矮屏上按高度收小 */
  .frame {
    width: min(100%, (100dvh - 220px) * 0.75);
    aspect-ratio: 3 / 4;
    align-self: center;
    background: var(--paper-2);
  }
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    /* 长按保存要的是图片本身，不要被选中文字 */
    -webkit-touch-callout: default;
  }
  .frame img:not([src]) {
    visibility: hidden;
  }
  .share .error {
    margin: 0;
    font-size: 13px;
    color: var(--seal);
  }
  .share .error:empty {
    display: none;
  }
  .row {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: var(--fs-s);
    letter-spacing: 0.1em;
  }
  .row label {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    cursor: pointer;
  }
  .row input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--seal);
  }
  .hint {
    margin-left: auto;
    color: var(--ink-2);
  }
  .save {
    display: none;
    margin-left: auto;
    color: var(--ink);
    text-underline-offset: 4px;
  }
  /* 桌面用鼠标，没有长按：给下载链接 */
  @media (hover: hover) and (pointer: fine) {
    .hint {
      display: none;
    }
    .save {
      display: block;
    }
  }
  .share form {
    display: contents;
  }
  .close {
    height: 48px;
    padding: 0 0 0 0.6em;
    background: none;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    font-size: var(--fs-m);
    letter-spacing: 0.6em;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .screen.reading {
      gap: 56px;
    }
    .to-history {
      display: block;
    }
    .share-btn {
      padding: 0 18px;
    }
    .top {
      height: 48px;
    }
    .back {
      display: none;
    }
    .top .brand {
      display: flex;
    }
    .layout {
      width: min(1120px, 100%);
      margin-inline: auto;
      display: grid;
      grid-template-columns: 400px minmax(0, 1fr);
      gap: 96px;
      align-items: start;
    }
    /* 左栏卦象与结论随滚动固定 */
    .lead {
      position: sticky;
      top: 32px;
      gap: 36px;
    }
    .main {
      gap: 52px;
      padding-top: 8px;
    }
    .asked {
      gap: 10px;
    }
    .asked p {
      font-size: var(--fs-l);
    }
    .gua {
      padding: 12px 0;
    }
    .lines {
      gap: 18px;
    }
    .lines :global(.yao) {
      gap: 14px;
    }
    .lines :global(svg) {
      width: 210px;
      height: 20px;
    }
    .lines :global(.mark) {
      font-size: var(--fs-m);
    }
    .names {
      gap: 16px;
    }
    h1 {
      font-size: 60px;
      letter-spacing: 0.22em;
    }
    .zhi {
      padding-top: 70px;
      font-size: 18px;
    }
    .gz {
      margin: 0;
      font-size: 13px;
    }
    .verdict {
      gap: 22px;
      padding: 28px 0;
    }
    .duan {
      width: 76px;
      height: 76px;
      font-size: 44px;
    }
    .said {
      gap: 10px;
    }
    .conclusion {
      font-size: 26px;
    }
    .basis {
      font-size: var(--fs-s);
    }
    .block {
      gap: 18px;
    }
    .head {
      font-size: var(--fs-m);
    }
    .head::before {
      width: 7px;
      height: 7px;
    }
    .list {
      font-size: 17px;
      line-height: 1.9;
    }
    .list :global(li) {
      gap: 14px;
    }
    .texts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px;
      padding-top: 28px;
      border-top: 1px solid var(--rule);
    }
    .text {
      gap: 16px;
    }
    .ci {
      font-size: 28px;
    }
