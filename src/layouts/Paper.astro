---
// 纸面的知识页（卦页、六十四卦目录、黄历与节气）：页头、页脚和纸色底。不带起卦脚本。
// 简体与繁体（/zh-hant/）共用；界面文字两种写法并排写在 t() 里。
import Columns from '../components/Columns.astro';
import { HANT } from '../data/gua-slugs';
// 正文（宋体）补字与语言切换用字（tools/subset-fonts.py 生成）：fontsource 切片里没有的字，排在它之后先用这里的。
import '../styles/paper-fonts.css';
import Page from './Page.astro';

// 每页一份标题字体子集（tools/subset-fonts.py）：预加载，首次渲染就用标题字体，不再换字体。
// 简体是站酷小薇；繁体是芫荽，它缺的字另有一份霞鹜文楷 TC 子集（{slug}-wk），两条 @font-face 同名，
// 按 unicode-range 分工。按栏目分目录：gua/（卦页、目录）、huangli/（黄历与节气），繁体各带 -hant。
const SUBSETS = import.meta.glob<string>('../fonts/*/*.woff2', { query: '?url', import: 'default', eager: true });
const RANGES = import.meta.glob<Record<string, string>>('../fonts/*/ranges.json', { import: 'default', eager: true });

interface Props {
  title: string;
  description: string;
  /** 简体页的路径（/gua/…/）；繁体页自动加 /zh-hant 前缀 */
  path: string;
  /** 目录页：栏目「六十四卦」的首页（aria-current="page"；卦页是 "true"，点它回目录）。 */
  index?: boolean;
  /** 本页属于哪一栏（栏目表 columns.ts 的 path），默认六十四卦 */
  at?: string;
  /** 本页是这一栏的首页（aria-current="page"），默认同 index */
  home?: boolean;
  /** 标题字体子集在哪个目录（src/fonts/{group}/，繁体 {group}-hant/），默认 gua */
  group?: string;
  /** 本页的标题字体子集：卦的 slug，目录页是 index */
  subset: string;
  hant?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, path, index = false, at = '/gua/', home = index, group = 'gua', subset, hant = false, ogType = index ? 'website' : 'article' } = Astro.props;
const t = (hans: string, tw: string) => (hant ? tw : hans);
const [self, other] = hant ? [HANT + path, path] : [path, HANT + path];
const dir = hant ? `${group}-hant` : group;
const table = RANGES[`../fonts/${dir}/ranges.json`] ?? {};
// 主子集必须有，缺了就让构建失败；补字子集（-wk）只有缺字的页才有。
if (!table[subset]) throw new Error(`ranges.json 里没有 ${dir}/${subset}：重跑 tools/subset-fonts.py`);
const fonts = [subset, `${subset}-wk`]
  .filter((k) => table[k])
  .map((k) => ({ url: SUBSETS[`../fonts/${dir}/${k}.woff2`], range: table[k] }));
if (fonts.some((f) => !f.url)) throw new Error(`缺标题字体子集 ${dir}/${subset}：重跑 tools/subset-fonts.py`);
// 只在本页内联：各页的 unicode-range 互相重叠，合进一个样式表会取到别页的文件。
// 排在 fontsource 之后，同一个字就先用这个小文件。
const family = hant ? 'Iansui' : 'ZCOOL XiaoWei';
const face = fonts
  .map((f) => `@font-face{font-family:'${family}';font-style:normal;font-weight:400;font-display:swap;src:url(${f.url}) format('woff2');unicode-range:${f.range}}`)
  .join('');
const wikisource = 'https://zh.wikisource.org/wiki/周易';
const license = `https://creativecommons.org/licenses/by-sa/4.0/deed.${hant ? 'zh-hant' : 'zh-hans'}`;
---

<Page title={title} description={description} path={self} alternate={other} hant={hant} themeColor="#f8f4ed" ogType={ogType}>
  <Fragment slot="head">
    {fonts.map((f) => <link rel="preload" href={f.url} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={face} />
  </Fragment>
  <div class:list={['page', { index }]}>
    <header class="top">
      <a class="brand" href="/" aria-label={t('六爻首页', '六爻首頁')}>
        <span class="seal" aria-hidden="true">爻</span>
        <span class="name" aria-hidden="true">六爻</span>
      </a>
      {/* 页头只有这一个 nav 地标：栏目；往卦、语言切换是右侧工具区（设计稿 20、D17）。
          桌面不再有「起卦」线框按钮（M16-1），由栏目第一项「起卦」代替；页底的起卦块仍直达写下所问。 */}
      <Columns at={at} page={home} hant={hant} />
      <div class="tools">
        <a class="past" href="/?history">往卦</a>
        {/* 语言切换（设计稿 14、D11，方案 B）：两页都是「简 | 繁」，当前那个不是链接。
            单字读屏只念一个字，各补一段视觉隐藏的「体中文」「體中文」；当前那个再说一声「当前」（繁体页「目前」）：
            Chrome 的无障碍树不暴露 aria-current，不能只靠它。 */}
        <span class="lang" role="group" aria-label={t('语言', '語言')}>
          {hant ? (
            <a href={other} hreflang="zh-Hans" lang="zh-Hans">简<span class="sr">体中文</span></a>
          ) : (
            <span aria-current="true" lang="zh-Hans">简<span class="sr">体中文（当前）</span></span>
          )}
          <span class="bar" aria-hidden="true"></span>
          {hant ? (
            <span aria-current="true" lang="zh-Hant">繁<span class="sr">體中文（目前）</span></span>
          ) : (
            <a href={other} hreflang="zh-Hant" lang="zh-Hant">繁<span class="sr">體中文</span></a>
          )}
        </span>
      </div>
    </header>
    <slot />
    {/* 各栏目自己的数据来源与许可：传 slot="foot"（一句一个 <p>，句末的句号包进 .stop，桌面并成一行时换成间隔号） */}
    {Astro.slots.has('foot') ? (
      <footer class="foot"><slot name="foot" /></footer>
    ) : index ? (
      <footer class="foot">
        <p>
          {t('卦爻辞原文取自', '卦爻辭原文取自')}<a href={wikisource} rel="noopener">{t('维基文库', '維基文庫')}</a>（<a href={license} rel="license noopener">CC BY-SA 4.0</a>）；{t('白话为本站原创 · 仅供传统文化参考与娱乐', '白話為本站原創 · 僅供傳統文化參考與娛樂')}
        </p>
      </footer>
    ) : (
      <footer class="foot">
        <p>
          {t('卦爻辞、彖传、象传原文取自', '卦爻辭、彖傳、象傳原文取自')}<a href={wikisource} rel="noopener">{t('维基文库', '維基文庫')}</a>（<a href={license} rel="license noopener">CC BY-SA 4.0</a>）；{t('白话为本站原创', '白話為本站原創')}<span class="stop">。</span>
        </p>
        <p>{t('仅供传统文化参考与娱乐', '僅供傳統文化參考與娛樂')}<span class="stop">。</span></p>
      </footer>
    )}
  </div>
</Page>

<style is:global>
  html,
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  :focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }
</style>

<style>
  /* 行高全部写死：字体异步换上时行数、高度不变，不产生布局偏移。
     左右内边距改了，要同步 Invite.astro、Columns.astro 的 --edge-l / --edge-r（起卦块、手机栏目行靠它们出血到屏幕边）。 */
  .page {
    --gap: 40px;
    min-height: 100dvh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    padding: max(16px, env(safe-area-inset-top)) max(var(--gutter), env(safe-area-inset-right))
      max(56px, env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left));
    line-height: 1.8;
  }
  .page.index {
    --gap: 36px;
  }

  /* 手机：两行共 88 高，上行品牌与「往卦 · 简 | 繁」，下行栏目（Columns 自己占第二行）。
     DOM 顺序是品牌、栏目、工具区，Tab 顺序同桌面的视觉顺序。 */
  .top {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: space-between;
    align-items: center;
  }
  .top a {
    color: var(--ink);
    text-decoration: none;
  }
  .brand {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .seal {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    background: var(--seal);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1;
    border-radius: var(--radius);
  }
  .name {
    font-size: var(--fs-s);
    letter-spacing: 0.4em;
  }
  /* 手机上间距 12px：语言切换每个字左右各有 15px 的点击区，看上去和别的项仍是二十多像素（设计稿 14）。 */
  .tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* 往卦：页头里只有「当前」用主色（当前栏目、当前语言），它是次要色，悬停变墨色 */
  .top .past {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    font-size: var(--fs-s);
    letter-spacing: 0.24em;
    color: var(--ink-2);
    transition: color var(--t-hover);
  }
  .top .past:hover {
    color: var(--ink);
  }

  /* 语言切换「简 | 繁」（设计稿 14、D11，方案 B）：当前语言墨色加粗、不是链接；另一个是次要色的链接，
     悬停变墨色。都不带下划线：纸面链接都不带，给当前那个加下划线反倒像能点。 */
  .lang {
    display: flex;
    align-items: center;
  }
  .lang > a,
  .lang > span[aria-current] {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    padding: 0 15px;
    font-size: var(--fs-s);
    letter-spacing: 0;
  }
  .lang > span[aria-current] {
    font-weight: 600;
  }
  .top .lang > a {
    color: var(--ink-2);
    transition: color var(--t-hover);
  }
  .top .lang > a:hover {
    color: var(--ink);
  }
  .bar {
    width: 1px;
    height: 12px;
    background: var(--rule);
  }
  /* 视觉隐藏、读屏照念。字重固定 400：看不见的字也会触发字体下载，跟着当前语言用 600 就要多下切片。 */
  .sr {
    font-weight: 400;
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }
  .foot :global(p) {
    margin: 0;
  }
  .foot :global(a) {
    color: inherit;
    text-underline-offset: 3px;
  }

  /* 768–1023：沿用手机版式，内容居中，最宽 640px */
  @media (min-width: 768px) and (max-width: 1023px) {
    .page {
      padding-inline: max(var(--gutter), calc(50% - 320px));
    }
  }

  @media (min-width: 1024px) {
    .page {
      --gap: 56px;
      padding: 32px 64px 72px;
    }
    .page.index {
      --gap: 48px;
    }
    /* 一行：品牌、栏目、工具区（设计稿 D17） */
    .top {
      display: flex;
      gap: 34px;
      height: 48px;
    }
    .brand {
      gap: 12px;
    }
    .seal {
      width: 30px;
      height: 30px;
      font-size: 19px;
    }
    .name {
      font-size: 15px;
    }
    .tools {
      gap: 28px;
    }
    /* 桌面每个字 34×44 */
    .lang > a,
    .lang > span[aria-current] {
      padding: 0 10px;
    }
    .foot {
      margin-top: auto;
      padding-top: 24px;
      border-top: 1px solid var(--rule);
      flex-direction: row;
      justify-content: center;
      gap: 0;
      font-size: 13px;
      letter-spacing: 0.08em;
    }
    /* 桌面并成一行，两句之间用间隔号 */
    .foot :global(.stop) {
      display: none;
    }
    .foot :global(p + p)::before {
      content: "·";
      margin-inline: 0.6em;
    }
    /* 目录页（设计稿 D10）：与格子同宽，左对齐，没有分隔线 */
    .index .foot {
      width: min(1120px, 100%);
      margin-inline: auto;
      padding-top: 0;
      border-top: none;
      justify-content: flex-start;
      font-size: var(--fs-xs);
      letter-spacing: 0.06em;
    }
  }
</style>
