---
// 纸面的知识页（卦页、六十四卦目录）：页头、页脚和纸色底。不带起卦脚本。
// 简体与繁体（/zh-hant/）共用；界面文字两种写法并排写在 t() 里。
import rangesHant from '../fonts/gua-hant/ranges.json';
import ranges from '../fonts/gua/ranges.json';
import { HANT } from '../data/gua-slugs';
import Page from './Page.astro';

// 每页一份标题字体子集（tools/subset-fonts.py）：预加载，首次渲染就用标题字体，不再换字体。
// 简体是站酷小薇；繁体是芫荽，它缺的字另有一份霞鹜文楷 TC 子集（{slug}-wk），两条 @font-face 同名，
// 按 unicode-range 分工。
const SUBSETS = import.meta.glob<string>(['../fonts/gua/*.woff2', '../fonts/gua-hant/*.woff2'], {
  query: '?url',
  import: 'default',
  eager: true,
});

interface Props {
  title: string;
  description: string;
  /** 简体页的路径（/gua/…/）；繁体页自动加 /zh-hant 前缀 */
  path: string;
  /** 目录页：页头不再链「六十四卦」，手机上改链「起卦」。 */
  index?: boolean;
  /** 本页的标题字体子集：卦的 slug，目录页是 index */
  subset: string;
  hant?: boolean;
}

const { title, description, path, index = false, subset, hant = false } = Astro.props;
const t = (hans: string, tw: string) => (hant ? tw : hans);
const [self, other] = hant ? [HANT + path, path] : [path, HANT + path];
const dir = hant ? 'gua-hant' : 'gua';
const table: Record<string, string> = hant ? rangesHant : ranges;
const fonts = [subset, `${subset}-wk`]
  .filter((k) => table[k])
  .map((k) => ({ url: SUBSETS[`../fonts/${dir}/${k}.woff2`], range: table[k] }));
if (!fonts.length || fonts.some((f) => !f.url)) throw new Error(`缺标题字体子集 ${dir}/${subset}：重跑 tools/subset-fonts.py`);
// 只在本页内联：各页的 unicode-range 互相重叠，合进一个样式表会取到别页的文件。
// 排在 fontsource 之后，同一个字就先用这个小文件。
const family = hant ? 'Iansui' : 'ZCOOL XiaoWei';
const face = fonts
  .map((f) => `@font-face{font-family:'${family}';font-style:normal;font-weight:400;font-display:swap;src:url(${f.url}) format('woff2');unicode-range:${f.range}}`)
  .join('');
const wikisource = 'https://zh.wikisource.org/wiki/周易';
const license = `https://creativecommons.org/licenses/by-sa/4.0/deed.${hant ? 'zh-hant' : 'zh-hans'}`;
---

<Page title={title} description={description} path={self} alternate={other} hant={hant} themeColor="#f8f4ed">
  <Fragment slot="head">
    {fonts.map((f) => <link rel="preload" href={f.url} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={face} />
  </Fragment>
  <div class:list={['page', { index }]}>
    <header class="top">
      <a class="brand" href="/" aria-label={t('六爻首页', '六爻首頁')}>
        <span class="seal" aria-hidden="true">爻</span>
        <span class="name" aria-hidden="true">六爻</span>
      </a>
      <nav aria-label={t('站内', '站內')}>
        {!index && <a href={hant ? `${HANT}/gua/` : '/gua/'}>六十四卦</a>}
        <a class="desk" href="/?history">往卦</a>
        {hant ? (
          <a href={other} hreflang="zh-Hans" lang="zh-Hans">简体</a>
        ) : (
          <a href={other} hreflang="zh-Hant" lang="zh-Hant">繁體</a>
        )}
        <a class="ask" href="/?ask">起卦</a>
      </nav>
    </header>
    <slot />
    {index ? (
      <footer class="foot">
        <p>
          {t('卦爻辞原文取自', '卦爻辭原文取自')}<a href={wikisource} rel="noopener">{t('维基文库', '維基文庫')}</a>（<a href={license} rel="license noopener">CC BY-SA 4.0</a>）；{t('白话为本站原创 · 仅供传统文化参考与娱乐', '白話為本站原創 · 僅供傳統文化參考與娛樂')}
        </p>
      </footer>
    ) : (
      <footer class="foot">
        <p>
          {t('卦爻辞、彖传、象传原文取自', '卦爻辭、彖傳、象傳原文取自')}<a href={wikisource} rel="noopener">{t('维基文库', '維基文庫')}</a>（<a href={license} rel="license noopener">CC BY-SA 4.0</a>）；{t('白话为本站原创', '白話為本站原創')}<span class="stop">。</span>
        </p>
        <p>{t('仅供传统文化参考与娱乐', '僅供傳統文化參考與娛樂')}<span class="stop">。</span></p>
      </footer>
    )}
  </div>
</Page>

<style is:global>
  html,
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  :focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }
</style>

<style>
  /* 行高全部写死：字体异步换上时行数、高度不变，不产生布局偏移。 */
  .page {
    --gap: 40px;
    min-height: 100dvh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    padding: max(16px, env(safe-area-inset-top)) max(var(--gutter), env(safe-area-inset-right))
      max(56px, env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left));
    line-height: 1.8;
  }
  .page.index {
    --gap: 36px;
  }

  .top {
    height: var(--tap);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .top a {
    color: var(--ink);
    text-decoration: none;
  }
  .brand {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .seal {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    background: var(--seal);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1;
    border-radius: var(--radius);
  }
  .name {
    font-size: var(--fs-s);
    letter-spacing: 0.4em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  nav a {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    font-size: var(--fs-s);
    letter-spacing: 0.24em;
  }
  /* 手机：卦页右上只有「六十四卦」，目录页只有「起卦」 */
  nav .desk,
  nav .ask {
    display: none;
  }
  .index nav .ask {
    display: flex;
    letter-spacing: 0.3em;
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }
  .foot p {
    margin: 0;
  }
  .foot a {
    color: inherit;
    text-underline-offset: 3px;
  }

  /* 768–1023：沿用手机版式，内容居中，最宽 640px */
  @media (min-width: 768px) and (max-width: 1023px) {
    .page {
      padding-inline: max(var(--gutter), calc(50% - 320px));
    }
  }

  @media (min-width: 1024px) {
    .page {
      --gap: 56px;
      padding: 32px 64px 72px;
    }
    .page.index {
      --gap: 48px;
    }
    .top {
      height: 48px;
    }
    .brand {
      gap: 12px;
    }
    .seal {
      width: 30px;
      height: 30px;
      font-size: 19px;
    }
    .name {
      font-size: 15px;
    }
    nav .desk {
      display: flex;
    }
    nav .ask,
    .index nav .ask {
      display: flex;
      padding: 0 22px;
      border: 1px solid var(--ink);
      border-radius: var(--radius);
      letter-spacing: 0.4em;
    }
    .foot {
      margin-top: auto;
      padding-top: 24px;
      border-top: 1px solid var(--rule);
      flex-direction: row;
      justify-content: center;
      gap: 0;
      font-size: 13px;
      letter-spacing: 0.08em;
    }
    /* 桌面并成一行，两句之间用间隔号 */
    .stop {
      display: none;
    }
    .foot p + p::before {
      content: "·";
      margin-inline: 0.6em;
    }
    /* 目录页（设计稿 D10）：与格子同宽，左对齐，没有分隔线 */
    .index .foot {
      width: min(1120px, 100%);
      margin-inline: auto;
      padding-top: 0;
      border-top: none;
      justify-content: flex-start;
      font-size: var(--fs-xs);
      letter-spacing: 0.06em;
    }
  }
</style>
